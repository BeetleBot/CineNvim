#!/bin/bash

# Define the isolated config directory
CONFIG_DIR="$HOME/.config/cinenvim"

# Initialize config if it doesn't exist
if [ ! -f "$CONFIG_DIR/init.lua" ]; then
    mkdir -p "$CONFIG_DIR"
    if [ -f "/usr/share/cinenvim/init.lua" ]; then
        cp /usr/share/cinenvim/init.lua "$CONFIG_DIR/init.lua"
    else
        echo "Error: Base init.lua not found. Ensure CineNvim is correctly installed."
        exit 1
    fi
    echo "CineNvim Initialized in $CONFIG_DIR"
fi

# Launch with isolated APPNAME
env NVIM_APPNAME=cinenvim nvim "$@"
